{
  "name": "openstorm-electron",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "backend:dev": "cd backend && nodemon server.js",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "electron:dev": "cross-env ELECTRON_DEV=true concurrently \"npm:backend:dev\" \"npm:frontend:dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:start": "cross-env ELECTRON_DEV=false electron .",
    "electron:build": "npm run frontend:build && electron-builder --linux --armv7l --arm64",
    "electron:build:win": "npm run frontend:build && electron-builder --win --x64 --ia32"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "wait-on": "^7.0.1",
    "nodemon": "^3.1.0"
  },
  "build": {
    "appId": "com.ancedric.openstorm",
    "files": [
      "frontend/dist/**/*",
      "backend/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "arch": ["armv7l", "arm64"]
    }
  }
}
